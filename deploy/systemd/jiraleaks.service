[Unit]
Description=jiraleaks — Jira secret scan (weekly, driven by jiraleaks.timer)
Documentation=https://github.com/wsgoggway/Jiraleaks
After=network-online.target
Wants=network-online.target
# Retry policy guard: at most 3 start attempts per hour, then stay failed.
StartLimitIntervalSec=3600
StartLimitBurst=3

[Service]
Type=oneshot
User=jiraleaks
Group=jiraleaks

# Credentials live in an EnvironmentFile readable only by root (mode 0600) —
# the unit itself carries no secrets, only variable names.
# Required keys: JIRA_URL, JIRA_PAT, JIRA_JQL
# Optional keys: JIRA_AUTH, JIRA_EMAIL
EnvironmentFile=/etc/jiraleaks/env

# Writable state managed by systemd: checkpoints and the sqlite findings store.
# StateDirectory is created at start and chowned to User=; StateDirectory and the
# private tmp are the only writable paths under ProtectSystem=strict, so reports
# are placed inside it as well.
StateDirectory=jiraleaks
StateDirectoryMode=0750
WorkingDirectory=/var/lib/jiraleaks

# Paths and scan scope (no secrets in the unit).
Environment=REPORT_OUTPUT_PATH=/var/lib/jiraleaks/reports
Environment=REPORT_FORMAT=all
Environment=JIRA_NO_PROXY=1
Environment=LOG_LEVEL=info
Environment=JIRALEAKS_DB_URL=sqlite:///var/lib/jiraleaks/findings.db?mode=rwc

# JIRA_URL / JIRA_JQL / JIRA_PAT are read from the environment, so the JQL needs
# no shell quoting here. --state-dir has no environment variable: pass it as a
# flag so checkpoints land on the state directory instead of the default
# relative ./.jiraleaks-state.
ExecStart=/usr/local/bin/jiraleaks --state-dir /var/lib/jiraleaks

# A scan of a large Jira instance can outlive the 90 s default.
TimeoutStartSec=3600
TimeoutStopSec=60

# Restarting a oneshot is allowed for on-failure only (never on clean exit);
# three attempts per hour, see StartLimit* in [Unit].
Restart=on-failure
RestartSec=300

# Information only: systemd runs these lines without a shell, so `$(date)` needs
# an explicit /bin/sh. The exit status is recorded by systemd as the unit result
# and $EXIT_STATUS is not available to ExecStartPost.
ExecStartPost=-/bin/sh -c 'echo "jiraleaks: scan finished at $(date -Is)"'

StandardOutput=journal
StandardError=journal

# Hardening. SystemCallFilter= and MemoryDenyWriteExecute= are deliberately not
# set: their effect cannot be validated without running the unit on the host.
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
LockPersonality=yes
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0027

[Install]
WantedBy=multi-user.target
